# Configure your provider; never commit .env.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=120
AGENT_SDK_TIMEOUT_SECONDS=120
AGENT_SDK_MAX_CONCURRENCY=2
AGENT_SDK_MAX_TURNS=3
ACTOR_EXTRACTION_MAX_CONCURRENCY=8
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set a client name and a project URL or contact for your deployment.
WIKIMEDIA_USER_AGENT=
# Optional persistent storage location.
# DATA_DIR=/absolute/path/to/persistent/data
